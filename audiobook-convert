#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: audiobook-convert [GLOBAL_OPTIONS] COMMAND [ARGUMENTS...]

Run one audiobook processing stage or metadata utility.

Commands:
  workspace        Copy an audiobook into an isolated working directory
  clean-workspace  Delete a converter-created working directory
  inspect          Examine an audiobook's structure, metadata, and readiness
  fix-tag-encoding Convert legacy-encoded MP3 text tags to Unicode
  track-tags       Inspect track numbers and titles (stage 0)
  set-track-number Set sequential Track metadata on one directory
  rename-track-id  Rename audio files from their Track tags (stage 1)
  chapters         Create an mkvmerge chapter file (stage 2)
  images           Extract embedded artwork and select a cover (stage 3)
  audiobook-tags   Interactively create global tags XML (stage 4)
  create-mka       Merge audio, chapters, tags, and cover art (stage 5)
  show-tags        Inspect raw ID3 metadata for one audio file
  help             Show this help, or help for a command

Global options:
  -h, --help       Show this help output

Each command sources one stage module and invokes stage::run. Stages remain
independently runnable; this command does not run an automatic pipeline.

Examples:
  audiobook-convert inspect ./book
  audiobook-convert workspace ./book
  cd ../book.audiobook-work
  audiobook-convert fix-tag-encoding WINDOWS-1251 ./*.mp3
  audiobook-convert track-tags .
  audiobook-convert set-track-number --dry-run .
  audiobook-convert rename-track-id --dry-run .
  audiobook-convert chapters chapters.txt
  audiobook-convert help create-mka
EOF
}

# Resolve modules relative to this root-level entrypoint so dispatch works from
# any audiobook directory, including when the repository root is on PATH.
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Parse only options that apply to the top-level command. Once the subcommand
# is found, its remaining arguments are left for the selected module.
while (($# > 0)); do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		echo "error: unknown global option: $1" >&2
		usage >&2
		exit 2
		;;
	*)
		break
		;;
	esac
done

if (($# == 0)); then
	echo "error: command is required" >&2
	usage >&2
	exit 2
fi

command_name="$1"
shift

if [[ "$command_name" == "help" ]]; then
	if (($# == 0)); then
		usage
		exit 0
	fi
	if (($# > 1)); then
		echo "error: help accepts at most one command" >&2
		usage >&2
		exit 2
	fi
	command_name="$1"
	set -- --help
fi

case "$command_name" in
workspace) stage_module="workspace" ;;
clean-workspace) stage_module="clean-workspace" ;;
inspect) stage_module="inspect" ;;
fix-tag-encoding) stage_module="fix-tag-encoding" ;;
track-tags) stage_module="0-track-tags" ;;
set-track-number) stage_module="set-track-number" ;;
rename-track-id) stage_module="1-rename-track-id" ;;
chapters) stage_module="2-chapters" ;;
images) stage_module="3-images" ;;
audiobook-tags) stage_module="4-audiobook-tags" ;;
create-mka) stage_module="5-create-mka" ;;
show-tags) stage_module="show-tags" ;;
*)
	echo "error: unknown command: $command_name" >&2
	usage >&2
	exit 2
	;;
esac

# Load helpers proven to be shared by multiple stages, then load only the
# selected stage module so stage-specific implementation remains isolated.
# shellcheck source=/dev/null
source "$project_dir/modules/common.sh"
# shellcheck source=/dev/null
source "$project_dir/modules/$stage_module.sh"
stage::run "$@"
