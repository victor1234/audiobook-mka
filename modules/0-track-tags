# This module is sourced by ./audiobook-convert.
stage::usage() {
	cat <<'EOF'
Usage: audiobook-convert track-tags [DIRECTORY]

Show a table with audio file names, track numbers, and title tags.

Use this before creating an MKA audiobook to check that source audio tags are
ordered and named correctly.

Arguments:
  DIRECTORY  Directory to inspect. Default: current working directory

The script scans audio files in DIRECTORY and prints three columns:
  FILE   File name
  TRACK  Track value from metadata
  TITLE  Title value from metadata

When running through mise from a subdirectory, pass "$PWD" explicitly:
  mise exec -- audiobook-convert track-tags "$PWD"
EOF
}

stage::parse_arguments() {
	target_dir="."

	while (($# > 0)); do
		case "$1" in
		-h | --help)
			stage::usage
			exit 0
			;;
		--)
			shift
			if (($# > 0)); then
				target_dir="$1"
				shift
			fi
			break
			;;
		-*)
			echo "error: unknown option: $1" >&2
			stage::usage >&2
			exit 2
			;;
		*)
			target_dir="$1"
			shift
			break
			;;
		esac
	done

	if (($# > 0)); then
		echo "error: too many arguments" >&2
		stage::usage >&2
		exit 2
	fi
}

stage::validate_target_directory() {
if [[ ! -d "$target_dir" ]]; then
	echo "error: directory not found: $target_dir" >&2
	exit 1
fi

}

stage::find_audio_files() {
# Scan only source audio files from the target directory. Sidecar files such as
# cover.jpg, tags.xml, and chapters.txt are intentionally ignored for this
# pre-MKA check.
mapfile -d '' audio_files < <(
	common::find_audio_files "$target_dir"
)

if ((${#audio_files[@]} == 0)); then
	echo "error: no audio files found in $target_dir" >&2
	exit 1
fi

}

stage::print_track_tags() {
# Read metadata as JSON, shape it into tab-separated rows, then align columns.
exiftool -q -j -Track -Title "${audio_files[@]}" |
	jq -r '
    ["FILE", "TRACK", "TITLE"],
    (.[] | [
      (.SourceFile | split("/")[-1]),
      (.Track // "" | tostring),
      (.Title // "")
    ])
    | @tsv
  ' |
	column -t -s $'\t'

}

stage::run() {
	stage::parse_arguments "$@"
	stage::validate_target_directory
	common::require_commands column exiftool jq || exit 1
	stage::find_audio_files
	stage::print_track_tags
}
