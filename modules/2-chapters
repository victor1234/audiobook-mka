# This module is sourced by ./audiobook-convert.
stage::usage() {
	cat <<'EOF'
Usage: audiobook-convert chapters [OUTPUT]

Create an mkvmerge simple chapter file from MP3 files in the current directory.

Arguments:
  OUTPUT  Chapter file to write. Default: chapters.txt

The script scans only the current directory, sorts MP3 files naturally, and
creates one chapter per file using cumulative durations from ffprobe. Chapter
names are read from each MP3 file's Title metadata tag.
EOF
}

stage::parse_arguments() {
case "${1:-}" in
-h | --help)
	stage::usage
	exit 0
	;;
esac

# Write to the first argument, or to chapters.txt by default.
output="${1:-chapters.txt}"

}

stage::find_mp3_files() {
# Scan only the current directory and sort naturally, so 2.mp3 comes before 10.mp3.
mapfile -d '' mp3_files < <(find . -maxdepth 1 -type f -iname '*.mp3' -print0 | sort -zV)

if ((${#mp3_files[@]} == 0)); then
	echo "error: no MP3 files found in current directory" >&2
	exit 1
fi

}

# Return the MP3 duration as seconds with a fractional part.
stage::duration_seconds() {
	local file="$1"

	ffprobe -v error \
		-show_entries format=duration \
		-of default=noprint_wrappers=1:nokey=1 \
		"$file"
}

# Return the visible chapter title from the MP3 Title metadata tag.
stage::chapter_title() {
	local file="$1"
	local title

	title="$(exiftool -q -q -s3 -Title "$file")"
	title="$(common::trim "$title")"

	if [[ -z "$title" ]]; then
		echo "error: missing Title tag: ${file#./}" >&2
		exit 1
	fi

	printf '%s' "$title"
}

# Convert fractional seconds to simple chapter timestamps: HH:MM:SS.mmm.
stage::timestamp() {
	local seconds="$1"
	awk -v seconds="$seconds" '
    BEGIN {
      total_ms = int((seconds * 1000) + 0.5)
      hours = int(total_ms / 3600000)
      total_ms %= 3600000
      minutes = int(total_ms / 60000)
      total_ms %= 60000
      secs = int(total_ms / 1000)
      ms = total_ms % 1000
      printf "%02d:%02d:%02d.%03d", hours, minutes, secs, ms
    }
  '
}

stage::write_chapters() {
# Emit mkvmerge simple chapters: CHAPTERxx=start time and CHAPTERxxNAME=title.
{
	elapsed="0"
	chapter_number=1

	for file in "${mp3_files[@]}"; do
		# Each chapter starts at the cumulative elapsed time from previous MP3s.
		duration="$(stage::duration_seconds "$file")"
		if [[ ! "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
			echo "error: could not read duration for ${file#./}" >&2
			exit 1
		fi

		# Use the Title metadata tag as the visible chapter title.
		title="$(stage::chapter_title "$file")"

		printf 'CHAPTER%02d=%s\n' "$chapter_number" "$(stage::timestamp "$elapsed")"
		printf 'CHAPTER%02dNAME=%s\n' "$chapter_number" "$title"

		# Keep elapsed in seconds and format only when writing the chapter start.
		elapsed="$(awk -v a="$elapsed" -v b="$duration" 'BEGIN { printf "%.9f", a + b }')"
		((chapter_number++))
	done
} >"$output"

}

stage::report_created_chapters() {
echo "created $output with ${#mp3_files[@]} chapters"

}

stage::run() {
	stage::parse_arguments "$@"
	common::require_commands exiftool ffprobe || exit 1
	stage::find_mp3_files
	stage::write_chapters
	stage::report_created_chapters
}
