# This module is sourced by ./audiobook-convert.
stage::usage() {
	cat <<'EOF'
Usage: audiobook-convert images [OUTPUT_DIR]

Extract unique embedded images from audio files in the current directory.

Arguments:
  OUTPUT_DIR  Directory for extracted unique images. Default: images

The script preserves each extracted image's original format, deduplicates by
exact file content, and saves the best image as OUTPUT_DIR/cover.jpg. The best
cover is selected by largest pixel area, then largest file size.
EOF
}

stage::parse_arguments() {
case "${1:-}" in
-h | --help)
	stage::usage
	exit 0
	;;
esac

# Output directory can be overridden by the first argument.
output_dir="${1:-images}"

}

stage::find_audio_files() {
# Only scan the current directory. The script is intended to be run inside one
# audiobook folder, not recursively across the whole library.
mapfile -d '' audio_files < <(
	common::find_audio_files .
)

if ((${#audio_files[@]} == 0)); then
	echo "error: no audio files found in current directory" >&2
	exit 1
fi

}

stage::prepare_output_directory() {
mkdir -p "$output_dir"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

}

stage::seed_seen_hashes() {
declare -gA seen_hashes=()

# Seed the dedupe set from images already in the output directory. This makes
# repeated runs idempotent and avoids creating image-002.jpg for the same cover.
while IFS= read -r -d '' image; do
	hash="$(sha256sum "$image" | awk '{print $1}')"
	seen_hashes["$hash"]=1
done < <(
	find "$output_dir" -maxdepth 1 -type f \
		\( -iname '*.bmp' -o -iname '*.gif' -o -iname '*.jpg' -o -iname '*.jpeg' \
		-o -iname '*.png' -o -iname '*.tif' -o -iname '*.tiff' -o -iname '*.webp' \) \
		-print0
)

}

stage::next_number() {
	local number=1
	local extension="$1"

	while [[ -e "$output_dir/image-$(printf '%03d' "$number").${extension}" ]]; do
		((number++))
	done

	printf '%03d' "$number"
}

# ffprobe reports embedded JPEG covers as "mjpeg". Keep the original encoded
# image bytes, but choose a normal filename extension for each supported codec.
stage::extension_for_codec() {
	case "$1" in
	bmp) printf '%s\n' 'bmp' ;;
	gif) printf '%s\n' 'gif' ;;
	mjpeg) printf '%s\n' 'jpg' ;;
	png) printf '%s\n' 'png' ;;
	tiff) printf '%s\n' 'tif' ;;
	webp) printf '%s\n' 'webp' ;;
	*) return 1 ;;
	esac
}

stage::image_dimensions() {
	local image="$1"

	ffprobe -v error \
		-select_streams v:0 \
		-show_entries stream=width,height \
		-of csv=s=x:p=0 \
		"$image"
}

stage::promote_best_cover() {
	local best_image=""
	local best_area=-1
	local best_size=-1
	local image dimensions width height area size extension cover

	while IFS= read -r -d '' image; do
		dimensions="$(stage::image_dimensions "$image" || true)"
		[[ "$dimensions" =~ ^[0-9]+x[0-9]+$ ]] || continue

		width="${dimensions%x*}"
		height="${dimensions#*x}"
		area=$((width * height))
		size="$(stat -c '%s' "$image")"

		# Prefer the largest image by pixel area. If dimensions tie, keep the
		# larger file because it is usually the less-compressed cover.
		if ((area > best_area || (area == best_area && size > best_size))); then
			best_image="$image"
			best_area="$area"
			best_size="$size"
		fi
	done < <(
		find "$output_dir" -maxdepth 1 -type f \
			\( -iname '*.bmp' -o -iname '*.gif' -o -iname '*.jpg' -o -iname '*.jpeg' \
			-o -iname '*.png' -o -iname '*.tif' -o -iname '*.tiff' -o -iname '*.webp' \) \
			-print0
	)

	if [[ -z "$best_image" ]]; then
		echo "warning: no extracted image could be promoted to cover" >&2
		return 0
	fi

	extension="${best_image##*.}"
	extension="${extension,,}"
	cover="$output_dir/cover.jpg"

	# Keep JPEG covers byte-for-byte. Convert other image formats so downstream
	# mkvmerge commands can always attach a predictable cover.jpg file.
	if [[ "$extension" == "jpg" || "$extension" == "jpeg" ]]; then
		if [[ "$best_image" != "$cover" ]]; then
			cp "$best_image" "$cover"
		fi
	else
		ffmpeg -v error -y -i "$best_image" -frames:v 1 "$cover"
	fi

	echo "selected $cover from ${best_image#./}"
}

stage::extract_unique_images() {
extracted_count=0
unique_count=0
duplicate_count=0

for audio in "${audio_files[@]}"; do
	# Embedded cover art is exposed by ffmpeg/ffprobe as video streams, even when
	# the container is an audio-only file such as MP3, M4A, M4B, or FLAC.
	mapfile -t stream_indexes < <(
		ffprobe -v error \
			-select_streams v \
			-show_entries stream=index \
			-of csv=p=0 \
			"$audio" || true
	)

	for stream_index in "${stream_indexes[@]}"; do
		[[ -n "$stream_index" ]] || continue

		codec="$(
			ffprobe -v error \
				-select_streams "$stream_index" \
				-show_entries stream=codec_name \
				-of default=noprint_wrappers=1:nokey=1 \
				"$audio"
		)"

		if ! extension="$(stage::extension_for_codec "$codec")"; then
			echo "warning: unsupported image codec '$codec' in ${audio#./}" >&2
			continue
		fi

		tmp_image="$tmp_dir/extracted-${extracted_count}.${extension}"
		# Stream copy preserves the embedded image as-is instead of re-encoding it.
		if ! ffmpeg -v error -y -i "$audio" -map "0:${stream_index}" -frames:v 1 -c:v copy "$tmp_image"; then
			echo "warning: could not extract image stream $stream_index from ${audio#./}" >&2
			continue
		fi

		((++extracted_count))
		hash="$(sha256sum "$tmp_image" | awk '{print $1}')"

		# Deduplicate by exact file content. Covers that look the same but have
		# different metadata or encoding are intentionally kept as separate files.
		if [[ -n "${seen_hashes[$hash]:-}" ]]; then
			((++duplicate_count))
			continue
		fi

		number="$(stage::next_number "$extension")"
		output="$output_dir/image-${number}.${extension}"
		mv "$tmp_image" "$output"
		seen_hashes["$hash"]=1
		((++unique_count))
	done
done
}

stage::report_extracted_images() {
stage::promote_best_cover

echo "extracted $unique_count unique images to $output_dir ($duplicate_count duplicates skipped)"

}

stage::run() {
	stage::parse_arguments "$@"
	common::require_commands ffprobe ffmpeg sha256sum || exit 1
	stage::find_audio_files
	stage::prepare_output_directory
	stage::seed_seen_hashes
	stage::extract_unique_images
	stage::report_extracted_images
}
